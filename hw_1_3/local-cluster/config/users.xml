<clickhouse>
    <profiles>
        <default>
            <max_threads>2</max_threads>
            <max_memory_usage>1500000000</max_memory_usage>
            <log_queries>1</log_queries>
            <distributed_foreground_insert>1</distributed_foreground_insert>
            <insert_quorum>2</insert_quorum>
            <insert_quorum_timeout>120000</insert_quorum_timeout>
            <distributed_ddl_task_timeout>180</distributed_ddl_task_timeout>
        </default>
    </profiles>
    <users>
        <default>
            <password replace="replace">homework</password>
            <networks replace="replace"><ip>::/0</ip></networks>
            <access_management>1</access_management>
        </default>
    </users>
</clickhouse>
